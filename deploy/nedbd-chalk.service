# /etc/systemd/system/nedbd-chalk.service — CHALK's NEDB daemon (loopback only).
# Uses the nedbd-v2 binary bundled in the repo's node_modules (same engine as
# `chalk serve` autostarts). Set NEDB_TMK in the env file to encrypt at rest.
[Unit]
Description=NEDB daemon for CHALK / Sports-Rater
After=network.target

[Service]
Type=simple
User=chalk
Group=chalk
WorkingDirectory=/opt/chalk
EnvironmentFile=/opt/chalk/.env
ExecStart=/opt/chalk/node_modules/nedb-engine/nedbd-v2-linux-x64 --dag-v3 --host 127.0.0.1 --port 7070 --data /opt/chalk/chalk-data
Restart=always
RestartSec=3
# One engine per data dir, always: nedbd refuses a split-brain open anyway.
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/chalk/chalk-data

[Install]
WantedBy=multi-user.target
