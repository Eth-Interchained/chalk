# /opt/chalk/.env — copy, fill, chmod 600, chown chalk:chalk. Never commit the real one.

# Model (AiAS PIN -> hearth on the A6000). Any OpenAI-compatible endpoint works.
CHALK_LLM_URL=https://api.aiassist.net/api/v1/pin/chat/completions
CHALK_LLM_KEY=
CHALK_LLM_MODEL=GLM-4-32B
CHALK_LLM_PROVIDER=pin

# Defaults for the public site.
CHALK_DEFAULT_TEAM=TB
CHALK_DEFAULT_SEASON=2025

# In-process watch loop inside `chalk serve` (re-ingest + pulse). Unset CHALK_WATCH_SEASON to disable.
CHALK_WATCH_SEASON=2026
CHALK_WATCH_INTERVAL=1800

# Pulse v1 (TheSportsDB). "3" = free test key (schedule + scores). Premium unlocks livescore.
THESPORTSDB_KEY=3

# Store: embedded (default) keeps NEDB in-process at CHALK_DATA. To use a daemon instead set NEDB_URL.
CHALK_STORE=embedded
# NEDB_URL=http://127.0.0.1:7070
# NEDBD_TOKEN=
