# /etc/systemd/system/chalk.service — CHALK API + Sports-Rater client with NEDB
# EMBEDDED in-process (no daemon). The watch loop (re-ingest + pulse) runs inside
# this process when CHALK_WATCH_SEASON is set. One engine per data dir: nothing
# else may open /opt/chalk/chalk-data while this unit runs.
[Unit]
Description=CHALK football intelligence (sports-rater.com)
After=network.target

[Service]
Type=simple
User=chalk
Group=chalk
WorkingDirectory=/opt/chalk
EnvironmentFile=/opt/chalk/.env
Environment=CHALK_STORE=embedded
Environment=CHALK_DATA=/opt/chalk/chalk-data
ExecStart=/usr/bin/node /opt/chalk/bin/chalk.ts serve --host 127.0.0.1 --port 4040
ReadWritePaths=/opt/chalk/chalk-data
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
